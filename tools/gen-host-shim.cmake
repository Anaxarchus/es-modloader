# Generates the loader's host shim from the game's API header (run as
# `cmake -DAPI=<es_api.h> -DOUT=<dir> -P gen-host-shim.cmake`):
#
#   <OUT>/es_host.h       a C prototype `es_<field>` for every function of EsHost,
#                         with the same signature: the header the harness's
#                         `foreign "es_host.h"` block names (harness/host.dado),
#                         whose declarations dadoc checks with _Static_assert.
#   <OUT>/es_host_shim.c  each `es_<field>` defined as a one-line forward to the
#                         game's table, `host->field(...)`, and es_shim_missing(),
#                         which names the first function the game's table lacks.
#
# Both come from es_api.h alone, so the shim cannot drift from the contract: a
# field added to EsHost is forwarded on the next build, and a host.dado
# declaration that disagrees with the header fails to compile.
cmake_minimum_required(VERSION 3.21)
if(NOT API OR NOT OUT)
	message(FATAL_ERROR "usage: cmake -DAPI=<es_api.h> -DOUT=<dir> -P gen-host-shim.cmake")
endif()
file(READ "${API}" text)
string(FIND "${text}" "typedef struct EsHost {" begin)
string(FIND "${text}" "} EsHost;" end)
if(begin EQUAL -1 OR end EQUAL -1)
	message(FATAL_ERROR "${API} has no EsHost struct")
endif()
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${text}" ${begin} ${length} body)
# One field per line; a semicolon would split CMake's list, so drop them first.
string(REPLACE ";" "" body "${body}")
string(REPLACE "\n" ";" lines "${body}")

set(protos "")
set(forwards "")
set(checks "")
set(count 0)
foreach(line IN LISTS lines)
	# `type (ES_CALL *name)(params)`, ES_CALL being the calling convention.
	if(NOT line MATCHES "^[ \t]*([A-Za-z_][A-Za-z0-9_ ]*[ *]+)\\((ES_CALL )?\\*([a-z_0-9]+)\\)\\(([^)]*)\\)")
		continue()
	endif()
	string(STRIP "${CMAKE_MATCH_1}" ret)
	set(name "${CMAKE_MATCH_3}")
	string(STRIP "${CMAKE_MATCH_4}" params)
	# The argument names, for the forward: the last word of each parameter.
	set(args "")
	if(NOT params STREQUAL "void" AND NOT params STREQUAL "")
		string(REPLACE "," ";" plist "${params}")
		foreach(p IN LISTS plist)
			string(STRIP "${p}" p)
			if(NOT p MATCHES "([A-Za-z_][A-Za-z0-9_]*)$")
				message(FATAL_ERROR "cannot name the parameter \"${p}\" of EsHost::${name}")
			endif()
			list(APPEND args "${CMAKE_MATCH_1}")
		endforeach()
	endif()
	list(JOIN args ", " call)
	if(params STREQUAL "")
		set(params "void")
	endif()
	# `const char *` reads better than `const char*` in the output.
	string(REGEX REPLACE " *\\*$" " *" ret "${ret}")
	if(ret MATCHES "\\*$")
		set(decl "${ret}es_${name}(${params})")
	else()
		set(decl "${ret} es_${name}(${params})")
	endif()
	if(ret STREQUAL "void")
		set(body_ "game->${name}(${call});")
	else()
		set(body_ "return game->${name}(${call});")
	endif()
	string(APPEND protos "${decl};\n")
	string(APPEND forwards "${decl} { ${body_} }\n")
	string(APPEND checks "\tif(!ES_HOST_HAS(host, ${name}) || !host->${name})\n\t\treturn \"${name}\";\n")
	math(EXPR count "${count} + 1")
endforeach()
if(count LESS 100)
	message(FATAL_ERROR "found only ${count} functions in ${API}'s EsHost")
endif()

file(MAKE_DIRECTORY "${OUT}")
set(note "/* Generated by tools/gen-host-shim.cmake from es_api.h (${count} functions). Do not edit. */")
file(WRITE "${OUT}/es_host.h.tmp" "${note}
/* The game's host table as plain C functions, for the harness (harness/host.dado). */
#ifndef ES_HOST_H_
#define ES_HOST_H_

#include <stdint.h>

${protos}
#endif
")
file(WRITE "${OUT}/es_host_shim.c.tmp" "${note}
#include \"es_api.h\"
#include \"es_host.h\"

#include <stddef.h>

/* The game's table, set by es_loader_init before anything else runs. */
const EsHost *es_shim_game = NULL;
#define game es_shim_game

/* The first function the harness forwards to that the game's table does not
 * have, or NULL when it has them all. */
const char *es_shim_missing(const EsHost *host)
{
${checks}	return NULL;
}

${forwards}")
# Only touch the outputs when they change, so a rebuild does not recompile them.
foreach(f es_host.h es_host_shim.c)
	file(COPY_FILE "${OUT}/${f}.tmp" "${OUT}/${f}" ONLY_IF_DIFFERENT)
	file(REMOVE "${OUT}/${f}.tmp")
endforeach()
