class Game

// The game, as a mod sees it. A mod is handed one `Game` in every hook and
// reaches the game only through it. `dadoc --emit=script-api` writes this
// class's signatures into the SDK (sdk/es/game.dado) that mods compile against.

// Write a line to the game's log.
void log(string text):
    host_log(text)

// Show a message to the player.
void message(string text):
    host_message(text)

// The engine's step counter: 60 steps per second of game time.
int step():
    return host_step()

// The name of the system the player is in.
string system():
    return host_system_name()

// Ships in the current system, indexed 0 ..< ship_count() for this hook only.
int ship_count():
    return host_ship_count()

// The player's flagship's index, or -1.
int flagship():
    return host_flagship()

// Ship i's name.
string ship_name(int i):
    return host_ship_name(i)

// Ship i's model (its hull's name, e.g. "Sparrow").
string ship_model(int i):
    return host_ship_model(i)

// Whether ship i is the player's.
bool is_player(int i):
    return host_ship_is_player(i)

// Whether ship i is disabled.
bool is_disabled(int i):
    return host_ship_is_disabled(i)

// Ship i's hull points.
float hull(int i):
    return host_ship_hull(i)

// Ship i's maximum hull points.
float max_hull(int i):
    return host_ship_max_hull(i)

// Ship i's shield points.
float shields(int i):
    return host_ship_shields(i)

// Ship i's maximum shield points.
float max_shields(int i):
    return host_ship_max_shields(i)

// Ship i's energy, as an absolute amount (not a fraction of its capacity; see
// energy_fraction).
float energy(int i):
    return host_ship_energy(i)

// Ship i's fuel, as an absolute amount (not a fraction of its capacity; see
// fuel_fraction).
float fuel(int i):
    return host_ship_fuel(i)

// Set a level; the game clamps it to [0, max].
void set_hull(int i, float value):
    host_ship_set_hull(i, value)

// Set ship i's shields; the game clamps them to [0, max].
void set_shields(int i, float value):
    host_ship_set_shields(i, value)

// The player's conditions, shared with missions and events.
int condition(string name):
    return host_condition(name)

// Set one of the player's conditions; it is saved with the pilot.
void set_condition(string name, int value):
    host_set_condition(name, value)

// ---- Mod API 2 ----

// The date, as days since the game's epoch.
int day():
    return host_day()

// The true (data) name of the system the player is in, or "".
string here():
    return host_here()

// The galaxy: every valid, accessible system, sorted by true name.
int system_count():
    return host_system_count()

// The true name of system i, 0 ..< system_count().
string system_at(int i):
    return host_system_at(i)

// The government a system belongs to, by name ("" for none).
string system_government(string system):
    return host_system_government(system)

// The systems linked to this one by hyperspace lanes.
int link_count(string system):
    return host_system_link_count(system)

// The system's k-th linked system, 0 ..< link_count(system).
string link(string system, int k):
    return host_system_link(system, k)

// Whether any planet in the system is inhabited.
bool inhabited(string system):
    return host_system_inhabited(system)

// The defense fleets of the system's planets: what a player fights to dominate them.
int defense_count(string system):
    return host_system_defense_count(system)

// The k-th defense fleet's name, 0 ..< defense_count(system).
string defense_fleet(string system, int k):
    return host_system_defense_fleet(system, k)

// Apply data changes as an event body, as a plugin's event would; they are
// saved with the pilot. Besides data changes, the body may hold what any event
// may: `visit "<system>"` and `visit planet "<planet>"` lines (and their
// `unvisit` forms) and condition assignments. Answers false for an empty body.
// For example:
//     game.change("system \"Alpha Centauri\"\n\tgovernment \"Free Worlds\"")
bool change(string text):
    return host_change(text)

// Government `government`'s attitude toward `toward` (below 0 is hostile).
float attitude(string government, string toward):
    return host_attitude(government, toward)

// The player's reputation with a government (below 0 is hostile).
float reputation(string government):
    return host_reputation(government)

// Set the player's reputation with a government.
void set_reputation(string government, float value):
    host_set_reputation(government, value)

// Whether a plugin with this name is installed and enabled. A mod can ship a
// companion plugin as a switch the player flips in the game's plugin list.
bool plugin_enabled(string name):
    return host_plugin_enabled(name)

// A fleet definition's average strength: the sum of its ships' costs.
float fleet_strength(string fleet):
    return host_fleet_strength(fleet)

// ---- Mod API 3 ----

// A fleet definition's expected stats, averaged over its variants by weight.
// "ships" (how many), "hull", "shields", "dps" (the shield plus hull damage its
// weapons deal per second) and "cost" are totals for the fleet; "speed" is the
// average top speed of its ships. 0 for an unknown fleet or stat.
float fleet_stat(string fleet, string stat):
    return host_fleet_stat(fleet, stat)

// How many fleets arrive in the system on their own (its `fleet` lines).
int system_fleet_count(string system):
    return host_system_fleet_count(system)

// The k-th of those fleets' names, 0 ..< system_fleet_count(system).
string system_fleet(string system, int k):
    return host_system_fleet(system, k)

// In flight only: add a fleet to the player's system under `government`, its
// ships tagged `tag`. With `arrive` they jump in; otherwise they are already
// there. Answers how many ships were added. Ships spawned now are in
// ship_count() from the next step.
int spawn(string fleet, string government, string tag, bool arrive):
    return host_spawn(fleet, government, tag, arrive)

// The tag a spawned ship carries, or "".
string ship_tag(int i):
    return host_ship_tag(i)

// The name of ship i's government.
string ship_government(int i):
    return host_ship_government(i)

// Ship i's strength: its cost, the measure fleet_strength uses.
float ship_strength(int i):
    return host_ship_strength(i)

// The strength of the ships in the system with this tag that can still fight.
float tag_strength(string tag):
    return host_tag_strength(tag)

// How many ships whose tag starts with `prefix` the player has disabled or
// destroyed since the last call with this prefix.
int player_kills(string prefix):
    return host_player_kills(prefix)

// Map overlays, drawn on every map view until cleared. Colours are 0..1.
void map_clear():
    host_map_clear()

// Draw a line between two systems on the map.
void map_line(string from, string to, float r, float g, float b):
    host_map_line(from, to, r, g, b)

// Draw a ring around a system on the map, with a label beside it ("" for none).
void map_marker(string system, float r, float g, float b, string label):
    host_map_marker(system, r, g, b, label)

// (Mod API 4.) Add a section to the map's side panel, shown below the map key
// while the player has this system selected: a heading in the given colour,
// then the text ("\n" starts a new line; long lines wrap). Keep markers short
// and put the details here. map_clear() removes them with the rest.
void map_detail(string system, string title, string text, float r, float g, float b):
    host_map_detail(system, title, text, r, g, b)

// The planet screen shows a button with this label ("" removes it); clicking
// it runs this mod's on_planet_button.
void planet_button(string label):
    host_planet_button(label)

// A panel with a title and text; add buttons with panel_button. Clicking one
// runs this mod's on_panel with the button's index. Opening a panel while one
// is open replaces it. Only from on_planet_button or on_panel, or from on_enter
// when the player lands (the planet screen then shows it at once). The planet
// screen shows the panel in its content area, as it shows the bank and trading.
void panel_open(string title, string text):
    host_panel_open(title, text)

// Add a button to the open panel; buttons are numbered from 0 in the order added.
void panel_button(string label):
    host_panel_button(label)

// Close this mod's panel.
void panel_close():
    host_panel_close()


// (Mod API 5.) The outfitter shows a button with this label ("" removes it).
// It is enabled while this mod's can_outfitter says so, and clicking it runs
// this mod's on_outfitter.
void outfitter_button(string label):
    host_outfitter_button(label)

// (Mod API 5.) In can_outfitter, on_outfitter and the on_confirm they lead to:
// how many ships are selected in the outfitter.
int outfitter_ship_count():
    return host_outfitter_ship_count()

// (Mod API 5.) The k-th selected ship's UUID, 0 ..< outfitter_ship_count(); 0
// is the ship in focus.
string outfitter_ship(int k):
    return host_outfitter_ship(k)

// (Mod API 5.) How many ships the player has (not destroyed), wherever they are.
int fleet_count():
    return host_fleet_count()

// (Mod API 5.) The k-th of the player's ships, as a UUID, 0 ..< fleet_count().
// A ship's UUID lasts across saving and loading; the methods below take it.
string fleet_ship(int k):
    return host_fleet_ship(k)

// (Mod API 5.) The name the player gave one of their ships ("" if unknown).
string fleet_ship_name(string ship):
    return host_fleet_ship_name(ship)

// (Mod API 5.) One of the player's ships' model, e.g. "Sparrow".
string fleet_ship_model(string ship):
    return host_fleet_ship_model(ship)

// (Mod API 5.) How many of an outfit (by its true name) a ship has installed.
int ship_outfit_count(string ship, string outfit):
    return host_ship_outfit_count(ship, outfit)

// (Mod API 5.) How many of a ship's installed outfits of this kind are integrated.
int ship_integrated_count(string ship, string outfit):
    return host_ship_integrated_count(ship, outfit)

// (Mod API 5.) Integrate one installed outfit that is not yet integrated: it
// stays installed (a weapon keeps its gun port or turret mount) but can no
// longer be uninstalled, sold, moved or plundered, and its mass and the outfit
// space it takes up are scaled by `scale` (0..1), each saving rounded to a
// whole number (a half up), as the game's masses and spaces are. Weapon and
// engine capacity and cargo space are left as they are. Saved with the ship. Ammunition, and outfits other
// outfits store or fire as ammunition, cannot be integrated. Answers whether it was.
bool ship_integrate(string ship, string outfit, float scale):
    return host_ship_integrate(ship, outfit, scale)

// (Mod API 5.) An outfit's display name, or "" for an unknown outfit.
string outfit_name(string outfit):
    return host_outfit_name(outfit)

// (Mod API 5.) An outfit's category, e.g. "Guns", "Systems", "Ammunition".
string outfit_category(string outfit):
    return host_outfit_category(outfit)

// (Mod API 5.) An outfit's attribute, as in its data ("outfit space", "cargo
// space", ...); "mass" and "cost" answer its mass and cost. 0 when it has none.
float outfit_attribute(string outfit, string attribute):
    return host_outfit_attribute(outfit, attribute)

// (Mod API 5.) Whether an outfit is a weapon (it goes in a gun port or turret mount).
bool outfit_is_weapon(string outfit):
    return host_outfit_is_weapon(outfit)

// (Mod API 5.) Ask the player to confirm, with OK and Cancel (the default).
// OK runs this mod's on_confirm with `token`; Cancel runs nothing. Only from a
// hook the player started: on_planet_button, on_panel, on_outfitter, on_confirm.
void confirm(string text, int token):
    host_confirm(text, token)

// (Mod API 6.) Text this mod keeps with the pilot under `key`, or "" if none.
// Saved and loaded with the pilot, apart from the conditions missions share:
// the place for a mod's own state, such as JSON. Other mods' keys are separate.
string data(string key):
    return host_data(key)

// (Mod API 6.) Keep `text` with the pilot under `key` ("" removes it). Up to 4 MB.
void set_data(string key, string text):
    host_set_data(key, text)

// (Mod API 6.) The true name of the planet the player is landed on, or "".
string planet():
    return host_planet()

// (Mod API 6.) A planet's display name, or "" for an unknown planet.
string planet_name(string planet):
    return host_planet_name(planet)

// (Mod API 6.) The true name of the system a planet is in.
string planet_system(string planet):
    return host_planet_system(planet)

// (Mod API 6.) The government a planet belongs to, by name.
string planet_government(string planet):
    return host_planet_government(planet)

// (Mod API 6.) How many planets a system has.
int planet_count(string system):
    return host_planet_count(system)

// (Mod API 6.) The system's k-th planet's true name, 0 ..< planet_count(system).
string planet_at(string system, int k):
    return host_planet_at(system, k)

// (Mod API 6.) Whether the player may use a service on a planet now: "bank",
// "trading", "job board", "hire crew", "outfitter" or "shipyard". True when the
// planet has it and the player has access, as the planet screen decides.
bool planet_service(string planet, string service):
    return host_planet_service(planet, service)

// (Mod API 6.) Give the open panel a table under its text, with these column
// headings separated by tabs ("Company\tPrice\tChange"). Rows follow with
// panel_row. The first column is aligned left, the others right.
void panel_columns(string headers):
    host_panel_columns(headers)

// (Mod API 6.) Add a row to the open panel's table, cells separated by tabs.
// Rows are numbered from 0; clicking one runs this mod's on_panel_row.
void panel_row(string cells):
    host_panel_row(cells)

// (Mod API 6.) Ask the player for a whole number from 1 to `most`. OK runs this
// mod's on_number with `token` and the number. Only from a hook the player started.
void ask_number(string text, int token, int most):
    host_ask_number(text, token, most)

// (Mod API 7.) Open this mod's panel on a full screen of its own, over the
// planet screen, as the outfitter and shipyard are: the title and the table
// (panel_columns, panel_row) fill the left, and a sidebar on the right holds
// the text and the buttons (panel_button). Clicking a column heading runs this
// mod's on_panel_header; the arrow keys step through the rows as clicks would.
// Only from a hook the player started, or to refresh this mod's open screen;
// panel_close, or Escape, closes it. panel_open goes back to the planet screen.
void screen_open(string title, string text):
    host_screen_open(title, text)

// (Mod API 7.) Show row `row` of the open panel's table as chosen (-1 for
// none); on a screen, the table scrolls to show it.
void panel_select(int row):
    host_panel_select(row)

// (Mod API 8.) Add a line chart at the top of this mod's screen sidebar
// (screen_open): `values` are numbers separated by commas, oldest first. Up to
// three series share one scale; each gets a line under the chart with its
// label and last value.
void panel_chart(string label, string values):
    host_panel_chart(label, values)

// (Mod API 8.) Put a job on the job board of the planet the player is landed
// on. `text` is the body of a mission as the game's data writes it: name,
// description, cargo, destination, deadline, and "on accept", "on complete"
// and "on fail" with payments and condition changes, which is how the mod
// learns what became of it. The game names the job "<mod name>: <name>".
// Answers whether it is on the board: not when the planet has no job board,
// the text makes no job, or a job of that name is already offered or taken.
// Jobs leave the board when the player takes off; offer them in on_enter.
bool offer_job(string name, string text):
    return host_offer_job(name, text)

// (Mod API 9.) Switch shipyard stock on or off for this session. While it is
// on, every shipyard shows a count on each hull the mod tracks (set_ship_stock)
// and will not sell one whose count is 0; untracked hulls stay unlimited. The
// switch is not saved, and loading a pilot turns it off again, so call this
// from on_enter: on_enter runs on every landing, including a pilot loaded on a
// planet (before the planet screen, and so its shipyard, can be used), and on
// the first step in flight after loading. on_load runs only once per game
// session, so calling it there alone is not enough.
void ship_stock_on(bool on):
    host_ship_stock_on(on)

// (Mod API 9.) How many of a ship model (its true name, as shipyard_model
// answers) a planet's shipyard has in stock; -1 when the model is untracked
// there (unlimited) or a name is unknown. The counts are saved with the pilot
// and read the same whether or not stock is switched on.
int ship_stock(string planet, string model):
    return host_ship_stock(planet, model)

// (Mod API 9.) Set how many of a ship model a planet's shipyard has in stock;
// a negative count untracks it there (unlimited). Saved with the pilot.
// Buying a hull in the shipyard lowers the count (once any used hulls the
// player sold there are gone). Selling one there raises it only while stock is
// on and this planet's shipyard sells the model and tracks it; otherwise the
// hull goes to the used hulls in stock (ship_in_stock) until takeoff. Unknown
// names change nothing.
void set_ship_stock(string planet, string model, int count):
    host_set_ship_stock(planet, model, count)

// (Mod API 9.) The text a planet's shipyard shows after "This ship is out of
// stock." for this model, in place of "New hulls are on order; check back in
// a few days.", e.g. where it can be ordered. "" removes it. Not saved: set it
// again in on_enter.
void ship_order_note(string planet, string model, string text):
    host_ship_order_note(planet, model, text)

// (Mod API 9.) How many ship models a planet's shipyards sell (its own and the
// ones its conditions open, as the planet screen lists them); 0 for none or an
// unknown planet.
int shipyard_count(string planet):
    return host_shipyard_count(planet)

// (Mod API 9.) The true name of the k-th model a planet's shipyards sell,
// 0 ..< shipyard_count(planet), sorted by true name; "" out of range.
string shipyard_model(string planet, int k):
    return host_shipyard_model(planet, k)

// (Mod API 9.) A ship model's display name, or "" for an unknown model.
string model_name(string model):
    return host_model_name(model)

// (Mod API 9.) A ship model's full new price in credits: its hull and the
// outfits it comes with, what a shipyard charges for a new one and exactly
// what buy_ship charges. 0 for an unknown model.
int model_cost(string model):
    return host_model_cost(model)

// (Mod API 9.) A ship model's category ("Light Freighter", "Heavy Warship",
// ...), or "".
string model_category(string model):
    return host_model_category(model)

// (Mod API 9.) The licenses a ship model needs, separated by commas
// ("Navy,Militia"), as named in the data; the player holds one when the
// condition "license: <name>" is set. "" for none or an unknown model.
string model_licenses(string model):
    return host_model_licenses(model)

// (Mod API 9.) Deliver the player a new ship of this model at the planet they
// are landed on, named `name` ("" for a random name), for its full new price,
// model_cost. For delivering orders: no shop is touched, not the shelf stock,
// the used hulls or outfits in stock, nor their prices. It sells no licenses:
// the player must already hold every license the model needs.
// Answers false and changes nothing when the player is not landed, the model
// is unknown, a license is missing, or they cannot pay. Only from a hook the
// player started: on_planet_button, on_panel, on_panel_row, on_outfitter,
// on_confirm, on_number, on_panel_header.
bool buy_ship(string model, string name):
    return host_buy_ship(model, name)

// (Mod API 9.) How many ships were destroyed in the player's system since the
// last engine step whose hooks ran, each ship once: in on_step, and in the
// on_day and on_enter that run in the same step (0 in hooks run from the
// planet screen or a panel). Ships destroyed while the hooks could not run
// (paused, the map or a dialog over the flight view, the step of landing)
// are reported at the next step whose hooks run, up to 4096; they are dropped
// when another pilot is loaded. The player's own ships are included, with the
// player's government.
int losses():
    return host_losses()

// (Mod API 9.) The k-th lost ship's model, the true name of its stock model
// (a variant answers its base model), 0 ..< losses(); "" out of range.
string loss_model(int k):
    return host_loss_model(k)

// (Mod API 9.) The government the k-th lost ship belonged to.
string loss_government(int k):
    return host_loss_government(k)

// (Mod API 9.) Whether the player destroyed the k-th lost ship: the flagship,
// an escort, or fire of the player's government. False for the player's own
// ships that something else destroyed.
bool loss_by_player(int k):
    return host_loss_by_player(k)

// (Mod API 9.) Write a label under a system on the map, in the colour (0..1),
// with no ring: it stacks with the labels of this and other mods' markers.
// map_clear() removes it with the rest; "" or an unknown system adds nothing.
void map_label(string system, string text, float r, float g, float b):
    host_map_label(system, text, r, g, b)

// (Mod API 9.) Draw a ring around a system on the map, `scale` times the size
// of a marker's ring (clamped to 0.5 .. 3; 1.5 stands out), in the colour
// (0..1), with no label: add one with map_label, which is drawn below the
// largest ring on that system. map_clear() removes it with the rest.
void map_ring(string system, float scale, float r, float g, float b):
    host_map_ring(system, scale, r, g, b)

// (Mod API 9.) How many used hulls of this model (counted as its base model)
// the player has sold to the shipyard of the planet they are landed on, which
// it sells again until they take off. 0 when not landed or for an unknown model.
int ship_in_stock(string model):
    return host_ship_in_stock(model)

// (Mod API 10.) The current price of a commodity in a system, by their true
// names: what the trading panel charges there now. 0 when the system has no
// market for it; -1 for an unknown system or commodity (and on an older game).
int trade_price(string system, string commodity):
    return host_trade_price(system, commodity)

// (Mod API 10.) The price the system's data sets for a commodity, before supply
// and demand move it. Events that change a system's trade change it too: the
// game keeps no price from before the events. 0 when the system has no market
// for it; -1 for an unknown system or commodity (and on an older game).
int trade_base_price(string system, string commodity):
    return host_trade_base_price(system, commodity)

// (Mod API 10.) How many standard commodities there are (0 on an older game).
int commodity_count():
    return host_commodity_count()

// (Mod API 10.) The k-th standard commodity's name, 0 ..< commodity_count(),
// in the order the trading panel lists them; "" out of range.
string commodity_name(int k):
    return host_commodity_name(k)

// (Mod API 10.) Park (`on` true) or unpark one of the player's ships, by UUID
// (fleet_ship), as the player's own park buttons do, wherever the ship is. The
// flagship and disabled ships cannot be parked. Answers true when the ship is
// now as asked. Only from a hook the player started (on_planet_button,
// on_panel, on_panel_row, on_panel_header, on_confirm, on_number; not the
// outfitter's) while landed; false elsewhere, for an unknown ship, and on an
// older game.
bool ship_park(string ship, bool on):
    return host_ship_park(ship, on)

// (Mod API 10.) Take one of the player's ships out of the fleet for good, by
// UUID, with everything on it and in its hold, for no money (as disowning it
// does): for a ship sold to a company, say. A ship carrying a mission's cargo
// or passengers is refused. The flagship goes only when another ship landed
// with the player can take its place. Only from a hook the player
// started while landed, and not from the outfitter's hooks (on_outfitter, and
// on_confirm for a dialog opened there). Answers true when it was removed.
bool ship_remove(string ship):
    return host_ship_remove(ship)

// (Mod API 10.) Whether one of the player's ships, by UUID, is parked.
bool ship_parked(string ship):
    return host_ship_parked(ship)

// (Mod API 10.) Switch outfitter stock on or off for this session, as
// ship_stock_on does for shipyards: each outfitter then shows the count of the
// outfits it sells that a mod tracks there, and sells no more than that (after
// any the player sold there, which it sells back first); untracked outfits stay
// unlimited. Not saved, and loading a pilot turns it off: call it from
// on_pilot_loaded (or on_enter, which also works on an older game). Maps and
// licenses are never tracked.
void outfit_stock_on(bool on):
    host_outfit_stock_on(on)

// (Mod API 10.) An outfit's count at a planet, by true names; -1 when untracked
// (unlimited), for an unknown name, and on an older game. Saved with the pilot.
int outfit_stock(string planet, string outfit):
    return host_outfit_stock(planet, outfit)

// (Mod API 10.) Set an outfit's count at a planet; a negative count untracks it
// (maps and licenses are not tracked).
// The outfitter lowers it for each one it sells (after those the player sold
// there). Outfits the player sells there are bought back first until takeoff,
// as always, and do not raise it.
void set_outfit_stock(string planet, string outfit, int count):
    host_set_outfit_stock(planet, outfit, count)

// (Mod API 10.) How many tons of a commodity (or other cargo, by name) the
// player carries: pooled while landed, and in the holds of their ships in the
// player's system that are not parked. 0 for none or an unknown name.
int cargo(string commodity):
    return host_cargo(commodity)

// (Mod API 10.) Post a notification to the other mods, under any loader, that
// listen for `name` (1 to 128 bytes of letters, digits and . _ : / -, e.g.
// "diplomacy.war_declared"). `payload` is text of up to 64 KiB the game does
// not read (JSON, by convention). It is queued, and delivered later to each
// listener's on_notification, never to this mod itself: after the step's
// hooks, after a hook the player started, after landing, after
// on_pilot_loaded, and once all mods have loaded; what is posted in on_save is
// delivered after the save. The game names the sender. Answers false when the
// name or payload is refused, or it was dropped (the queue holds 1024, and a
// mod may post 256 between deliveries, and 4 MiB wait at most); false on an
// older game.
bool notify(string name, string payload):
    return host_notify(name, payload)

// (Mod API 10.) Receive the notifications named `pattern` in on_notification: an
// exact name, or a prefix ending in "*" ("diplomacy.*"; "*" for all). It lasts
// until unlisten or the end of the game, across pilots: listen in on_load.
void listen(string pattern):
    host_listen(pattern)

// (Mod API 10.) Stop listening for a pattern, given exactly as to listen.
void unlisten(string pattern):
    host_unlisten(pattern)

// (Mod API 10.) Whether the game offers a feature, by name: "call:<name>" for a
// call of the game's C API added since API 9 ("call:ship_park"), "on_<hook>"
// for a hook it runs since API 9 ("on_save", "on_notification"), and features
// such as "notify", "trade_price", "outfit_stock", "ship_parking". Mods that
// use a newer feature check it here, so they still run on an older game. False
// for everything on an API 9 game.
bool has(string feature):
    return host_api_has(feature)

// (Mod API 10.) Split the time of the hook that is running into named sections,
// from now until the next section or the end of the hook, for the game's timing
// report (mod, hook, section); "" goes back to no section. A mod's names past
// its 32nd are counted as "(other)"; a name with a control character is ignored.
void timing_section(string name):
    host_timing_section(name)

// (Mod API 10.) Ship i's energy as a fraction of its capacity, 0..1 (0 for a
// ship with no battery).
float energy_fraction(int i):
    return host_ship_energy_fraction(i)

// (Mod API 10.) Ship i's fuel as a fraction of its capacity, 0..1 (0 for a
// ship with no fuel tank).
float fuel_fraction(int i):
    return host_ship_fuel_fraction(i)

// (Mod API 11.) Define outfits and ship models while the game runs. `text` is
// one or more top-level nodes in data-file syntax, each `outfit "<name>"`,
// `ship "<name>"` (a whole model) or `ship "<base>" "<name>"` (the game's
// ship-variant syntax). Outfits are defined before ships, so a ship may install
// an outfit the same text defines; a ship may install only defined outfits.
// What a mod defines is saved with the pilot, before its ships, and defined
// again when the pilot loads, so a save never depends on the mod having run. A
// definition cannot change once made for the pilot: give a new version a new
// name. A node is refused (and logged) when the game data or a plugin defines
// its name, another mod defined it for this pilot, it does not parse, or this
// mod defined it already with other text; the same text again is a no-op that
// counts. An open outfitter or shipyard lists what is new when it is opened
// again. In any hook. Answers how many it defined (0 on an older game).
int define(string text):
    return host_define(text)

// (Mod API 11.) Define the outfit `name` as a copy of the outfit `base` (from
// the game data, a plugin, or defined at runtime) with `changes` applied: the
// lines an outfit node holds, e.g. "\"shield generation\" 2.4\ncost 300000\n",
// `"display name" "..."` (which gives it its own plural unless `plural` is
// changed too), `description "..."` (which replaces the base's), and a `weapon`
// block whose keys override the base weapon's (its lists, such as effects, add
// to the base's). Without a display name it shows the base's. Saved as name,
// base and changes, so it is derived from the base again when the pilot loads.
// Refused as define(). In any hook. Answers true when it is defined (false on
// an older game).
bool define_outfit_variant(string name, string base, string changes):
    return host_define_outfit_variant(name, base, changes)

// (Mod API 11.) Define the ship model `name` as a variant of the model `base`,
// loaded as the game loads `ship "<base>" "<name>"` with `changes` as its
// children: what the changes leave out comes from the base, and what they give
// replaces the base's (an `outfits` block replaces all its outfits; use `add
// attributes` to add to its attributes). Saved and refused as
// define_outfit_variant(). In any hook. Answers true when it is defined (false
// on an older game).
bool define_ship_variant(string name, string base, string changes):
    return host_define_ship_variant(name, base, changes)

// (Mod API 11.) Whether an outfit (`kind` "outfit") or a ship model ("ship") is
// defined, by true name: 0 unknown (also for a name defined at runtime for
// another pilot, and on an older game), 1 by the game data or a plugin, 2 at
// runtime for this pilot (by any mod).
int defined(string kind, string name):
    return host_defined(kind, name)

// (Mod API 11.) On one of the player's ships (UUID, as fleet_ship), landed at
// the planet where the player is: replace up to `count` of the installed outfit
// `from` with `to`, one at a time, each only if the ship can take it as the
// outfitter checks (outfit, weapon, engine and cargo space, a gun port or
// turret mount for a weapon, and every attribute with a minimum, with the old
// one out and the new one in). Integrated outfits are not removable, and maps
// and licenses cannot be installed. Nothing is paid or sold. Only while landed,
// from a hook the player started (on_planet_button, on_panel, on_panel_row,
// on_panel_header, on_confirm, on_number; not the outfitter's). Answers how
// many were replaced (0 on an older game).
int ship_replace_outfit(string ship, string from, string to, int count):
    return host_ship_replace_outfit(ship, from, to, count)

// (Mod API 11.) Remove up to `count` of an outfit (by true name) from the
// player's `from`: "cargo" (the pooled cargo while landed; in flight, the holds
// of their ships in the system that are not parked), "storage" (the planetary
// storage where the player is landed; landed only), or "any" (cargo, then
// storage). Never takes installed outfits. In any hook with a world (also
// on_enter while landing, and on_step), not in on_save. Answers how many were
// removed (0 on an older game).
int outfit_take(string outfit, int count, string from):
    return host_outfit_take(outfit, count, from)

// (Mod API 11.) Add `count` of an outfit (by true name) to the player's `to`:
// "cargo" (the pooled cargo while landed, else the flagship's hold, whatever
// its free space, as missions' gifts do) or "storage" (the planetary storage
// where the player is landed; landed only). Maps and licenses cannot be given.
// Where outfit_take works. Answers how many were added (0 for an unknown
// outfit, and on an older game).
int outfit_give(string outfit, int count, string to):
    return host_outfit_give(outfit, count, to)

// (Mod API 11.) Ship i's distance from the player's flagship, in world units,
// in this step's snapshot; -1 when the flagship is not in the system, i is out
// of range, and on an older game.
float ship_distance(int i):
    return host_ship_distance(i)

// (Mod API 11.) Ship i's x position in the system, in world units (0 for an
// unknown index, and on an older game).
float ship_x(int i):
    return host_ship_x(i)

// (Mod API 11.) Ship i's y position in the system, in world units (0 for an
// unknown index, and on an older game).
float ship_y(int i):
    return host_ship_y(i)

// (Mod API 11.) Bring disabled ship i, not the player's, back to life: crew up
// to what it needs (at least 1), hull up to 10% of its maximum above the level
// at which it is disabled (never above the maximum), shields as they are, and
// no longer disabled, so it moves and fires again. `government` ("" keeps its
// own) takes it and its carried ships over; `personality` ("" keeps its own) is
// the tokens of a personality node, e.g. "heroic staying", and replaces its
// personality. A ship that wakes up is never a derelict again: the AI flies it
// as any other ship. Its tag stays. In flight, in any hook with ships. Answers
// true when it woke; false for an unknown index or government, a personality
// that does not parse, the player's ship, a ship that is not disabled or is
// destroyed, and on an older game.
bool ship_reactivate(int i, string government, string personality):
    return host_ship_reactivate(i, government, personality)
