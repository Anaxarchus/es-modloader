package esmod

import sdk "../sdk/es"

// Runs one mod. Every mod has an engine (a VM) of its own, and in it one
// Harness, made by entry.dado; the loader's C side (src/loader.c) reaches it
// through entry.dado's exports and decides which hook runs when.
//
// A mod is a class extending `es.Mod` (sdk/es/Mod.dados), built as one
// JavaScript file, or plain JavaScript extending the global `Mod` that
// `prepare` defines before the mod loads (probe.js). It is refused when it needs
// a newer mod API than this loader speaks (Mod.min_api; for a mod built before
// min_api, its api_version). Hooks are run by name (`call_*`), so a new hook
// needs no change here: only its name, from the C side, and a default in
// es.Mod. A hook that fails is reported here, worded as the C side's `mode`
// says: it switches some off (on_step, on_day, on_enter, can_outfitter), and a
// mod whose on_load fails is not loaded.
//
// The C side brackets every call into a mod's hook with the game's
// hook_timing, and runs it under the watchdog; this class does neither, so a
// mod that the watchdog stops cannot leave a bracket open.
private class Harness:
    foreign "probe.js":
        bool has_method(any o, string name)
        void install_globals(int api)
        void bind_mod(any o, any game)
        bool name_hook(int id, string name)
        string hook_name(int id)
        void invoke_int(int id, int a)
        int invoke_str(int id, string s)
        int invoke_json(int id, string args)
        int min_api_of(any o)

    // core:script's code for a stopped script, and the text of the Error a
    // stop raises in it.
    private int STOPPED = -2147483647
    private string STOP_TEXT = "the host stopped this script"

    Game game = Game()
    any obj = 0
    string name = ""

    // Define the globals a plain JavaScript mod builds on, then load the mod
    // whose JavaScript is `<path>.js`, naming it `n` in messages. Answers 0 when
    // it loaded and this loader runs it, or -1. Everything here may run the
    // mod's code (its module's top level, min_api and api_version, getters and
    // Proxy traps), so the C side runs it, and the hook checks after it, as one
    // armed, bracketed call.
    int prepare(string path, string n):
        name = n
        install_globals(sdk.MOD_API)
        try any o = Script.load(path) else e:
            // Stopped by the watchdog: the loader says so.
            if e.code == STOPPED || e.message.ends_with(STOP_TEXT):
                return -1
            game.log("dado: mod \"" + name + "\" did not load: " + e.message)
            return -1
        if !has_method(o, "api_version"):
            game.log("dado: mod \"" + name + "\" was refused: it does not extend es.Mod (or the global Mod)")
            return -1
        // Mod API 10: a mod says which API it needs (min_api), and runs on any
        // loader that speaks at least that. A mod built before min_api says only
        // the API it was built for, which this loader must speak, as before.
        try int needs = min_api_of(o) else e:
            if e.code == STOPPED || e.message.ends_with(STOP_TEXT):
                return -1
            game.log("dado: mod \"" + name + "\" was refused: " + e.message)
            return -1
        if needs == -2:
            game.log("dado: mod \"" + name + "\": its min_api() did not answer a whole number of at least 1; taken as 1")
            needs = 1
        if needs > sdk.MOD_API:
            game.log("dado: mod \"" + name + "\" was refused: it needs mod API " + string(needs) + " and this loader speaks up to " + string(sdk.MOD_API))
            return -1
        if needs < 0:
            try any version = o.api_version() else e:
                if e.code == STOPPED || e.message.ends_with(STOP_TEXT):
                    return -1
                game.log("dado: mod \"" + name + "\" was refused: " + e.message)
                return -1
            if int(version) < 1 || int(version) > sdk.MOD_API:
                game.log("dado: mod \"" + name + "\" was refused: it was built for mod API " + string(int(version)) + " and this loader speaks up to " + string(sdk.MOD_API))
                return -1
        obj = o
        bind_mod(o, game)
        return 0

    // Give hook `hook` the id `id` (the C side's), and answer whether the mod
    // has it: 1 or 0.
    int has(int id, string hook):
        return 1 if name_hook(id, hook) else 0

    // Run hook `id` (named by `has` first) with one int, one string, or the
    // arguments of a JSON array. Each answers what the hook answered (1 for
    // truthy, as can_outfitter's true, else 0), -4 when the mod has no such
    // hook, -2 when the watchdog stopped it, and -1 when it failed, which it
    // reports as `mode` says: 0 plainly, 1 "and its <hook> is now off", 2 "and
    // was not loaded".
    // The int path is the hot one (on_step, every engine step, for every mod):
    // the hook's answer is not needed there, and converting it would cost more
    // than the call itself, so it answers 0. (`has` made sure the hook exists.)
    int call_int(int id, int a, int mode):
        try invoke_int(id, a) else e:
            return failed(hook_name(id), mode, e.code, e.message)
        return 0

    // The hottest hook of all, on_step, called straight: the generic call costs
    // a tenth more per mod and step (README, "Performance").
    int call_step(int a, int mode):
        try obj.on_step(game, a) else e:
            return failed("on_step", mode, e.code, e.message)
        return 0

    int call_str(int id, string s, int mode):
        try int answer = invoke_str(id, s) else e:
            return failed(hook_name(id), mode, e.code, e.message)
        return answer

    int call_json(int id, string args, int mode):
        try int answer = invoke_json(id, args) else e:
            return failed(hook_name(id), mode, e.code, e.message)
        return answer

    int failed(string hook, int mode, int code, string message):
        // Stopped by the watchdog (core:script's STOPPED): the loader says so.
        if code == STOPPED || message.ends_with(STOP_TEXT):
            return -2
        if mode == 1:
            game.log("dado: mod \"" + name + "\" failed in " + hook + " and its " + hook + " is now off: " + message)
        else if mode == 2:
            game.log("dado: mod \"" + name + "\" failed in " + hook + " and was not loaded: " + message)
        else:
            game.log("dado: mod \"" + name + "\" failed in " + hook + ": " + message)
        return -1
