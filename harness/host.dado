bool host_ship_reactivate(i64 i, string8 government, string8 personality):
    if !valid_ship(i):
        return false
    ref []char8 g = strings.clone_to_cstring(government)
    defer #delete(g)
    ref []char8 p = strings.clone_to_cstring(personality)
    defer #delete(p)
    return es_ship_reactivate(i32(i), cstring(rawptr(&g[0])), cstring(rawptr(&p[0]))) != 0
