i64 host_ship_replace_outfit(string8 ship, string8 from, string8 to, i64 count):
    i32 n = count_i32(count)
    if n == 0:
        return 0
    ref []char8 s = strings.clone_to_cstring(ship)
    defer #delete(s)
    ref []char8 f = strings.clone_to_cstring(from)
    defer #delete(f)
    ref []char8 t = strings.clone_to_cstring(to)
    defer #delete(t)
    return es_ship_replace_outfit(cstring(rawptr(&s[0])), cstring(rawptr(&f[0])), cstring(rawptr(&t[0])), n)

i64 host_outfit_take(string8 outfit, i64 count, string8 from):
    i32 n = count_i32(count)
    if n == 0:
        return 0
    ref []char8 o = strings.clone_to_cstring(outfit)
    defer #delete(o)
    ref []char8 f = strings.clone_to_cstring(from)
    defer #delete(f)
    return es_outfit_take(cstring(rawptr(&o[0])), n, cstring(rawptr(&f[0])))

i64 host_outfit_give(string8 outfit, i64 count, string8 to):
    i32 n = count_i32(count)
    if n == 0:
        return 0
    ref []char8 o = strings.clone_to_cstring(outfit)
    defer #delete(o)
    ref []char8 t = strings.clone_to_cstring(to)
    defer #delete(t)
    return es_outfit_give(cstring(rawptr(&o[0])), n, cstring(rawptr(&t[0])))

f64 host_ship_distance(i64 i):
    if es_has_ship_distance() == 0 || !valid_ship(i):
        return -1.0
    return es_ship_distance(i32(i))

