    defer #delete(b)
    ref []char8 c = strings.clone_to_cstring(changes)
    defer #delete(c)
    return es_define_outfit_variant(cstring(rawptr(&n[0])), cstring(rawptr(&b[0])), cstring(rawptr(&c[0]))) != 0

