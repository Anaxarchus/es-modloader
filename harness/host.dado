// The game's C surface: the es_* functions of es_host.h, which the loader's
// generated shim (tools/gen-host-shim.cmake) forwards to the game's EsHost
// table (include/es_api.h); and the wrappers the `Game` class calls. A script
// cannot call a `foreign` function itself, so each one is reached through a
// Dado function here; this is also the one
// place a script's values are checked before they reach the game.
//
// The wrappers are named `host_*` because a class's method wins over a Dado
// function of the same name, and `Game` publishes the short names.
package esmod

import "core:strings"

foreign "es_host.h":
    void es_log(cstring text)
    void es_message(cstring text)
    i32 es_step()
    cstring es_system_name()
    i32 es_ship_count()
    i32 es_flagship()
    cstring es_ship_name(i32 i)
    cstring es_ship_model(i32 i)
    i32 es_ship_is_player(i32 i)
    i32 es_ship_is_disabled(i32 i)
    f64 es_ship_hull(i32 i)
    f64 es_ship_max_hull(i32 i)
    f64 es_ship_shields(i32 i)
    f64 es_ship_max_shields(i32 i)
    f64 es_ship_energy(i32 i)
    f64 es_ship_fuel(i32 i)
    void es_ship_set_hull(i32 i, f64 value)
    void es_ship_set_shields(i32 i, f64 value)
    i64 es_condition_get(cstring name)
    void es_condition_set(cstring name, i64 value)
    i32 es_day()
    cstring es_here()
    i32 es_system_count()
    cstring es_system_at(i32 i)
    cstring es_system_government(cstring system)
    i32 es_system_link_count(cstring system)
    cstring es_system_link(cstring system, i32 k)
    i32 es_system_inhabited(cstring system)
    i32 es_system_defense_count(cstring system)
    cstring es_system_defense_fleet(cstring system, i32 k)
    i32 es_change(cstring text)
    f64 es_attitude(cstring government, cstring toward)
    f64 es_reputation(cstring government)
    void es_set_reputation(cstring government, f64 value)
    i32 es_plugin_enabled(cstring name)
    f64 es_fleet_strength(cstring fleet)
    f64 es_fleet_stat(cstring fleet, cstring stat)
    i32 es_system_fleet_count(cstring system)
    cstring es_system_fleet(cstring system, i32 k)
    i32 es_spawn(cstring fleet, cstring government, cstring tag, i32 arrive)
    cstring es_ship_tag(i32 i)
    cstring es_ship_government(i32 i)
    f64 es_ship_strength(i32 i)
    f64 es_tag_strength(cstring tag)
    i32 es_player_kills(cstring prefix)
    void es_map_clear()
    void es_map_line(cstring from, cstring to, f64 r, f64 g, f64 b)
    void es_map_marker(cstring system, f64 r, f64 g, f64 b, cstring label)
    void es_map_detail(cstring system, cstring title, cstring text, f64 r, f64 g, f64 b)
    void es_planet_button(cstring label)
    void es_panel_open(cstring title, cstring text)
    void es_panel_button(cstring label)
    void es_panel_close()
    void es_outfitter_button(cstring label)
    i32 es_outfitter_ship_count()
    cstring es_outfitter_ship(i32 k)
    i32 es_fleet_count()
    cstring es_fleet_ship(i32 k)
    cstring es_fleet_ship_name(cstring ship)
    cstring es_fleet_ship_model(cstring ship)
    i32 es_ship_outfit_count(cstring ship, cstring outfit)
    i32 es_ship_integrated_count(cstring ship, cstring outfit)
    i32 es_ship_integrate(cstring ship, cstring outfit, f64 scale)
    cstring es_outfit_name(cstring outfit)
    cstring es_outfit_category(cstring outfit)
    f64 es_outfit_attribute(cstring outfit, cstring attribute)
    i32 es_outfit_is_weapon(cstring outfit)
    void es_confirm(cstring text, i32 token)
    cstring es_data(cstring key)
    void es_set_data(cstring key, cstring text)
    cstring es_planet()
    cstring es_planet_name(cstring planet)
    cstring es_planet_system(cstring planet)
    cstring es_planet_government(cstring planet)
    i32 es_planet_count(cstring system)
    cstring es_planet_at(cstring system, i32 k)
    i32 es_planet_service(cstring planet, cstring service)
    void es_panel_columns(cstring headers)
    void es_panel_row(cstring cells)
    void es_ask_number(cstring text, i32 token, i32 most)
    void es_screen_open(cstring title, cstring text)
    void es_panel_select(i32 row)
    void es_panel_chart(cstring label, cstring values)
    i32 es_offer_job(cstring name, cstring body)
    void es_ship_stock_on(i32 on)
    i32 es_ship_stock(cstring planet, cstring model)
    void es_set_ship_stock(cstring planet, cstring model, i32 count)
    void es_ship_order_note(cstring planet, cstring model, cstring text)
    i32 es_shipyard_count(cstring planet)
    cstring es_shipyard_model(cstring planet, i32 k)
    cstring es_model_name(cstring model)
    i64 es_model_cost(cstring model)
    cstring es_model_category(cstring model)
    cstring es_model_licenses(cstring model)
