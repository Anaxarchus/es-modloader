    defer #delete(o)
    return es_outfit_is_weapon(cstring(rawptr(&o[0]))) != 0

void host_confirm(string8 text, i64 token):
    if token < -2147483648 || token > 2147483647:
        return
    ref []char8 t = strings.clone_to_cstring(text)
    defer #delete(t)
    es_confirm(cstring(rawptr(&t[0])), i32(token))

// ---- Mod API 6 ----

private bool in_i32(i64 v):
    return v >= -2147483648 && v <= 2147483647

string8 host_data(string8 key):
    ref []char8 keyc = strings.clone_to_cstring(key)
    defer #delete(keyc)
    return from_c(es_data(cstring(rawptr(&keyc[0]))))

void host_set_data(string8 key, string8 text):
    ref []char8 keyc = strings.clone_to_cstring(key)
    defer #delete(keyc)
    ref []char8 textc = strings.clone_to_cstring(text)
    defer #delete(textc)
    es_set_data(cstring(rawptr(&keyc[0])), cstring(rawptr(&textc[0])))

string8 host_planet():
    return from_c(es_planet())

string8 host_planet_name(string8 planet):
    ref []char8 planetc = strings.clone_to_cstring(planet)
    defer #delete(planetc)
    return from_c(es_planet_name(cstring(rawptr(&planetc[0]))))

string8 host_planet_system(string8 planet):
    ref []char8 planetc = strings.clone_to_cstring(planet)
    defer #delete(planetc)
    return from_c(es_planet_system(cstring(rawptr(&planetc[0]))))

string8 host_planet_government(string8 planet):
    ref []char8 planetc = strings.clone_to_cstring(planet)
    defer #delete(planetc)
    return from_c(es_planet_government(cstring(rawptr(&planetc[0]))))

i64 host_planet_count(string8 system):
    ref []char8 systemc = strings.clone_to_cstring(system)
    defer #delete(systemc)
    return es_planet_count(cstring(rawptr(&systemc[0])))

string8 host_planet_at(string8 system, i64 k):
    ref []char8 systemc = strings.clone_to_cstring(system)
    defer #delete(systemc)
    if !in_i32(k):
        return ""
    return from_c(es_planet_at(cstring(rawptr(&systemc[0])), i32(k)))

bool host_planet_service(string8 planet, string8 service):
    ref []char8 planetc = strings.clone_to_cstring(planet)
    defer #delete(planetc)
    ref []char8 servicec = strings.clone_to_cstring(service)
    defer #delete(servicec)
    return es_planet_service(cstring(rawptr(&planetc[0])), cstring(rawptr(&servicec[0]))) != 0

