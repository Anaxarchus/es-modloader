    cstring es_loss_model(i32 k)
    cstring es_loss_government(i32 k)
    i32 es_loss_by_player(i32 k)
    void es_map_label(cstring system, cstring text, f64 r, f64 g, f64 b)
    void es_map_ring(cstring system, f64 scale, f64 r, f64 g, f64 b)
    i32 es_ship_in_stock(cstring model)
    // Mod API 10. Optional: an API 9 game lacks them, the shim then answers 0 or
    // "", and es_has_<field>() says whether the game has each.
    i32 es_trade_price(cstring system, cstring commodity)
    i32 es_trade_base_price(cstring system, cstring commodity)
    i32 es_commodity_count()
    cstring es_commodity_name(i32 k)
    i32 es_ship_park(cstring ship, i32 on)
    i32 es_ship_remove(cstring ship)
    i32 es_ship_parked(cstring ship)
    void es_outfit_stock_on(i32 on)
    i32 es_outfit_stock(cstring planet, cstring outfit)
    void es_set_outfit_stock(cstring planet, cstring outfit, i32 count)
    i32 es_cargo(cstring commodity)
    i32 es_notify(cstring name, cstring payload)
    void es_listen(cstring pattern)
    void es_unlisten(cstring pattern)
    i32 es_api_has(cstring feature)
    cstring es_api_features()
    void es_timing_section(cstring name)
    f64 es_ship_energy_fraction(i32 i)
    f64 es_ship_fuel_fraction(i32 i)
    // Mod API 11. Optional, as API 10's.
    i32 es_define(cstring text)
    i32 es_define_outfit_variant(cstring name, cstring base, cstring changes)
    i32 es_define_ship_variant(cstring name, cstring base, cstring changes)
    i32 es_defined(cstring kind, cstring name)
    i32 es_ship_replace_outfit(cstring ship, cstring from, cstring to, i32 count)
    i32 es_outfit_take(cstring outfit, i32 count, cstring from)
    i32 es_outfit_give(cstring outfit, i32 count, cstring to)
    f64 es_ship_distance(i32 i)
