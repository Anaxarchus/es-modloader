    ref []char8 headersc = strings.clone_to_cstring(headers)
    defer #delete(headersc)
    es_panel_columns(cstring(rawptr(&headersc[0])))

void host_panel_row(string8 cells):
    ref []char8 cellsc = strings.clone_to_cstring(cells)
    defer #delete(cellsc)
    es_panel_row(cstring(rawptr(&cellsc[0])))

void host_ask_number(string8 text, i64 token, i64 most):
    if !in_i32(token) || !in_i32(most):
        return
    ref []char8 textc = strings.clone_to_cstring(text)
    defer #delete(textc)
