// ---- Mod API 11 ----
// On an older game these calls are missing: the shim answers 0 or "" and does
// nothing; ship_distance, whose "unknown" is -1, checks first.

// A count the game can take: below 1 is nothing to do, beyond i32 is clamped.
private i32 count_i32(i64 count):
    if count < 1:
        return 0
    if count > 2147483647:
        return 2147483647
    return i32(count)

i64 host_define(string8 text):
    ref []char8 t = strings.clone_to_cstring(text)
    defer #delete(t)
    return es_define(cstring(rawptr(&t[0])))

